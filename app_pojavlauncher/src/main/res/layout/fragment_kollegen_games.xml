<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koll_games_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <TextView
            android:id="@+id/koll_games_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koll_games_title"
            android:textColor="@color/koll_accent"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/koll_games_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:text="@string/koll_games_subtitle"
            android:textColor="@color/koll_muted"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:id="@+id/koll_game_card_mc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/koll_panel_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_14sdp">

            <TextView
                android:id="@+id/koll_game_tile_mc"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:background="@drawable/koll_tile_green"
                android:gravity="center"
                android:text="@string/koll_game_mc_tile"
                android:textColor="@color/koll_bg"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/koll_game_title_mc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_minecraft"
                    android:textColor="@color/koll_text"
                    android:textSize="@dimen/_17ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/koll_game_desc_mc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_mc_desc"
                    android:textColor="@color/koll_muted"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u203A"
                android:textColor="@color/koll_accent"
                android:textSize="@dimen/_28ssp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/koll_game_card_world"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/koll_panel_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_14sdp">

            <TextView
                android:id="@+id/koll_game_tile_world"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:background="@drawable/koll_tile_blue"
                android:gravity="center"
                android:text="@string/koll_game_world_tile"
                android:textColor="@color/koll_bg"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/koll_game_title_world"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_world"
                    android:textColor="@color/koll_text"
                    android:textSize="@dimen/_17ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/koll_game_desc_world"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_world_desc"
                    android:textColor="@color/koll_muted"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u203A"
                android:textColor="@color/koll_muted"
                android:textSize="@dimen/_28ssp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/koll_game_card_clicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/koll_panel_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_14sdp">

            <TextView
                android:id="@+id/koll_game_tile_clicker"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:background="@drawable/koll_tile_gold"
                android:gravity="center"
                android:text="@string/koll_game_clicker_tile"
                android:textColor="@color/koll_bg"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/koll_game_title_clicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_clicker"
                    android:textColor="@color/koll_text"
                    android:textSize="@dimen/_17ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/koll_game_desc_clicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koll_game_clicker_desc"
                    android:textColor="@color/koll_muted"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u203A"
                android:textColor="@color/koll_muted"
                android:textSize="@dimen/_28ssp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>