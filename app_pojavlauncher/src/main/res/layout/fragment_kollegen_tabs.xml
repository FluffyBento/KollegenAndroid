<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/koll_tab_host"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/transparent">

	<LinearLayout
		android:id="@+id/koll_tab_bar"
		android:layout_width="0dp"
		android:layout_height="@dimen/_52sdp"
		android:orientation="horizontal"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<Button
			android:id="@+id/koll_tab_friends"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/kollegen_tab_friends"
			android:textAllCaps="true"
			android:textSize="@dimen/_12ssp"
			style="@android:style/Widget.Material.Button.Borderless" />

		<Button
			android:id="@+id/koll_tab_profile"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/kollegen_tab_profile"
			android:textAllCaps="true"
			android:textSize="@dimen/_12ssp"
			style="@android:style/Widget.Material.Button.Borderless" />

		<Button
			android:id="@+id/koll_tab_shop"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/kollegen_tab_shop"
			android:textAllCaps="true"
			android:textSize="@dimen/_12ssp"
			style="@android:style/Widget.Material.Button.Borderless" />
	</LinearLayout>

	<androidx.fragment.app.FragmentContainerView
		android:id="@+id/koll_tab_container"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/koll_tab_bar"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>