<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@android:color/transparent">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:orientation="vertical"
		android:gravity="center_horizontal"
		android:padding="@dimen/padding_heavy">

		<TextView
			android:id="@+id/koll_clicker_stats"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:textSize="@dimen/_12ssp"
			android:fontFamily="monospace" />

		<FrameLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:layout_marginVertical="@dimen/padding_heavy"
			android:id="@+id/koll_clicker_button_holder">

			<Button
				android:id="@+id/koll_clicker_button"
				android:layout_width="@dimen/_160sdp"
				android:layout_height="@dimen/_160sdp"
				android:text="Click!"
				android:textSize="@dimen/_24ssp"
				android:textAllCaps="false"
				android:gravity="center"
				android:padding="0dp"
				android:insetTop="0dp"
				android:insetBottom="0dp" />
		</FrameLayout>

		<TextView
			android:id="@+id/koll_clicker_level"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:layout_marginTop="@dimen/padding_medium"
			android:textSize="@dimen/_13ssp" />

		<FrameLayout
			android:id="@+id/koll_clicker_progress_bar_bg"
			android:layout_width="match_parent"
			android:layout_height="@dimen/_8sdp"
			android:layout_marginTop="@dimen/padding_small"
			android:background="@drawable/koll_progress_bg"
			android:padding="1dp">

			<View
				android:id="@+id/koll_clicker_progress_bar"
				android:layout_width="0dp"
				android:layout_height="match_parent" />
		</FrameLayout>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/koll_clicker_tabs"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@android:color/black">

		<Button
			android:id="@+id/koll_clicker_tab_upgrades"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Upgrades"
			android:textAllCaps="false"
			android:textSize="@dimen/_12ssp"
			android:paddingTop="@dimen/padding_small"
			android:paddingBottom="@dimen/padding_small"
			android:background="@android:color/transparent"
			android:textStyle="bold" />

		<Button
			android:id="@+id/koll_clicker_tab_achievements"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Erfolge"
			android:textAllCaps="false"
			android:textSize="@dimen/_12ssp"
			android:paddingTop="@dimen/padding_small"
			android:paddingBottom="@dimen/padding_small"
			android:background="@android:color/transparent" />

		<Button
			android:id="@+id/koll_clicker_tab_skins"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Skins"
			android:textAllCaps="false"
			android:textSize="@dimen/_12ssp"
			android:paddingTop="@dimen/padding_small"
			android:paddingBottom="@dimen/padding_small"
			android:background="@android:color/transparent" />
	</LinearLayout>

	<ScrollView
		android:id="@+id/koll_clicker_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:id="@+id/koll_clicker_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/padding_medium" />
	</ScrollView>
</LinearLayout>
