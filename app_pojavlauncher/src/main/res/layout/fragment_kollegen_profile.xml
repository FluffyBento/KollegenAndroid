<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/koll_profile_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@android:color/transparent">

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/padding_heavy">

			<LinearLayout
				android:id="@+id/koll_profile_guest"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center_horizontal"
				android:padding="@dimen/padding_heavy">

				<ImageView
					android:id="@+id/koll_profile_guest_logo"
					android:layout_width="@dimen/_96sdp"
					android:layout_height="@dimen/_96sdp"
					android:src="@drawable/ic_kollegen"
					android:scaleType="fitCenter"
					android:contentDescription="@string/app_name" />

				<TextView
					android:id="@+id/koll_profile_guest_text"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/padding_heavy"
					android:gravity="center"
					android:text="@string/kollegen_login_prompt"
					android:textSize="@dimen/_14ssp" />

				<Button
					android:id="@+id/koll_profile_login"
					android:layout_width="wrap_content"
					android:layout_height="@dimen/_46sdp"
					android:layout_marginTop="@dimen/padding_heavy"
					android:text="@string/kollegen_login_button"
					android:textAllCaps="false"
					android:textSize="@dimen/_14ssp" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/koll_profile_user"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">

					<ImageView
						android:id="@+id/koll_profile_avatar"
						android:layout_width="@dimen/_72sdp"
						android:layout_height="@dimen/_72sdp"
						android:scaleType="centerCrop"
						android:background="@drawable/koll_circle_bg"
						android:contentDescription="@string/kollegen_profile_avatar" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:layout_marginStart="@dimen/padding_medium"
						android:gravity="center_vertical">

						<TextView
							android:id="@+id/koll_profile_name"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="@dimen/_20ssp"
							android:textStyle="bold" />

						<TextView
							android:id="@+id/koll_profile_status"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="@dimen/_13ssp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:id="@+id/koll_profile_stats"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/padding_medium"
					android:orientation="horizontal"
					android:gravity="center_vertical">

					<TextView
						android:id="@+id/koll_profile_points"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:textSize="@dimen/_15ssp"
						android:drawablePadding="@dimen/padding_small" />

					<TextView
						android:id="@+id/koll_profile_level"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:textSize="@dimen/_15ssp" />

					<TextView
						android:id="@+id/koll_profile_code"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="@dimen/_15ssp" />
				</LinearLayout>

				<TextView
					android:id="@+id/koll_profile_bio"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/padding_medium"
					android:textSize="@dimen/_14ssp"
					android:visibility="gone" />

				<TextView
					android:id="@+id/koll_profile_equipped_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/padding_heavy"
					android:text="@string/kollegen_equipped"
					android:textSize="@dimen/_14ssp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/koll_profile_equipped"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/padding_small"
					android:textSize="@dimen/_13ssp" />

				<Button
					android:id="@+id/koll_profile_logout"
					android:layout_width="match_parent"
					android:layout_height="@dimen/_46sdp"
					android:layout_marginTop="@dimen/padding_heavy"
					android:text="@string/kollegen_logout"
					android:textAllCaps="false"
					android:textSize="@dimen/_14ssp" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>