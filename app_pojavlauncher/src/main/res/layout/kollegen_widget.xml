<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/koll_widget_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@drawable/koll_panel_bg"
	android:padding="12dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical">

		<TextView
			android:id="@+id/koll_widget_name"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16sp"
			android:textStyle="bold"
			android:textColor="#f3e9d8"
			android:maxLines="1"
			android:ellipsize="end"
			android:text="@string/app_name" />

		<TextView
			android:id="@+id/koll_widget_refresh"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="18sp"
			android:textColor="#f5a623"
			android:text="&#8635;" />
	</LinearLayout>

	<TextView
		android:id="@+id/koll_widget_meta"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:textSize="12sp"
		android:textColor="#b9a98c"
		android:maxLines="2"
		android:ellipsize="end"
		android:text="@string/kollegen_widget_loading" />
</LinearLayout>